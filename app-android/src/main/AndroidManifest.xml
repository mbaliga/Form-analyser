<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vision is the core modality: the camera films the archer (sagittal) for pose/form. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The Haptics setting (Settings -> Appearance) has always been persisted; without this it
         was read by nothing. Cues confirm a recorded arrow on a shooting line where the phone is
         often not being looked at. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- required="false": the app is fully usable without a camera (scoring, logs, progress),
         and required="true" made it un-installable on camera-less Chromebooks — which is exactly
         the desktop form factor the roadmap targets. CaptureScreen degrades gracefully. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- BYOK cloud coach calls only. On-device coaching and everything else stay offline; no key,
         no call. The AI coach is opt-in and every provider is bring-your-own-key. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- MediaPipe's usage-statistics client (datatransport, see app-android/build.gradle.kts) is the
         only thing that ever asked for this permission, and that client is excluded and replaced by
         a no-op sink. Nothing in Crocodyl checks connectivity, so strip it if any library
         contributes it again; tools/release/verify_manifest_contract.py rejects it too. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- allowBackup off (pre-release): auto-backup could restore an old-schema form-analyser.db
         onto a fresh install, making Room run a migration it can't reconcile and crash on first
         write. Local-first data is rebuilt on device; nothing here needs cloud backup yet. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_crocodyl"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FormAnalyser"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FormAnalyser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".EquipmentAtelierActivity"
            android:exported="false"
            android:theme="@style/Theme.FormAnalyser" />
        <activity
            android:name=".FencingActivity"
            android:exported="false"
            android:theme="@style/Theme.FormAnalyser" />
        <activity
            android:name=".MuayThaiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FormAnalyser" />
        <activity
            android:name=".BoulderingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FormAnalyser" />
        <activity
            android:name=".CommunityDirectoryActivity"
            android:exported="false"
            android:theme="@style/Theme.FormAnalyser" />

        <!--
          Home-screen widgets (docs/widgets.md), usable by any launcher. A launcher binds them through
          the system's widget service, so they are exported; android.permission.BIND_APPWIDGET, which
          only the system holds, is the one sender that can reach them. They read local data, never
          the network. tools/release/verify_manifest_contract.py allows exactly this shape.
        -->
        <receiver
            android:name=".widget.LastScorecardWidget"
            android:exported="true"
            android:label="@string/widget_last_scorecard_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_last_scorecard" />
        </receiver>
        <receiver
            android:name=".widget.ThisWeekWidget"
            android:exported="true"
            android:label="@string/widget_this_week_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_this_week" />
        </receiver>
        <receiver
            android:name=".widget.NextPhysioWidget"
            android:exported="true"
            android:label="@string/widget_next_physio_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_next_physio" />
        </receiver>
        <receiver
            android:name=".widget.ReadinessWidget"
            android:exported="true"
            android:label="@string/widget_readiness_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_readiness" />
        </receiver>
        <receiver
            android:name=".widget.ActiveRigWidget"
            android:exported="true"
            android:label="@string/widget_active_rig_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_active_rig" />
        </receiver>
        <receiver
            android:name=".widget.QuickStartWidget"
            android:exported="true"
            android:label="@string/widget_quick_start_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_quick_start" />
        </receiver>
        <!-- The widgets' own day-boundary alarm; only this app's PendingIntent can reach it. -->
        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="false" />
        <!-- Every widget tap goes through this windowless activity in its own empty task, so a tap
             never finishes a screen with unsaved work (docs/widgets.md#taps). -->
        <activity
            android:name=".widget.WidgetTapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Grants temporary access to an explicitly shared archive or an explicitly captured
          document photo, and only to the app the athlete chooses (or the camera app). exported=false
          + grantUriPermissions means no other app can reach either path uninvited.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
