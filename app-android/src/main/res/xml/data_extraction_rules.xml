<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Crocodyl is local-first. Do not copy private athlete data to cloud backup or device transfer. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
