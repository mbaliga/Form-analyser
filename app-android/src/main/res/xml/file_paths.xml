<?xml version="1.0" encoding="utf-8"?>
<!--
  The only two cache directories Crocodyl will ever hand to another app.

  Deliberately named cache subdirectories and not cache-path="." or files-path: an exported .crocbak
  can carry medical rows the athlete granted, and the database, the DataStore preferences and the
  db-recovery backups all live under paths that a wider rule would expose. Only files this app
  wrote to cache/share or cache/camera for the express purpose of sharing/capture are reachable.
-->
<paths>
    <cache-path name="share" path="share/" />
    <cache-path name="camera" path="camera/" />
</paths>
