<?xml version="1.0" encoding="utf-8"?>
<!-- Start training widget (docs/widgets.md). Resizable from 2x1 upwards; small, medium and large layouts.
     updatePeriodMillis is 0: the app pushes updates when data changes and at day boundaries. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_quick_start_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_pads"
    android:previewLayout="@layout/widget_preview_quick_start"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
