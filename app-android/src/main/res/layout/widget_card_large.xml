<?xml version="1.0" encoding="utf-8"?>
<!-- card template, large: label, title, meta and up to six rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/CrocodylWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
        android:id="@+id/widget_label"
        style="@style/CrocodylWidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <TextView
        android:id="@+id/widget_title"
        style="@style/CrocodylWidgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/widget_caption"
        style="@style/CrocodylWidgetCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />
    <TextView
        android:id="@+id/widget_detail1"
        style="@style/CrocodylWidgetBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_row1_key"
            style="@style/CrocodylWidgetRowKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_row1_value"
            style="@style/CrocodylWidgetRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_row2_key"
            style="@style/CrocodylWidgetRowKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_row2_value"
            style="@style/CrocodylWidgetRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_row3_key"
            style="@style/CrocodylWidgetRowKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_row3_value"
            style="@style/CrocodylWidgetRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_row4_key"
            style="@style/CrocodylWidgetRowKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_row4_value"
            style="@style/CrocodylWidgetRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_row5_key"
            style="@style/CrocodylWidgetRowKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_row5_value"
            style="@style/CrocodylWidgetRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_row6_key"
            style="@style/CrocodylWidgetRowKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_row6_value"
            style="@style/CrocodylWidgetRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_footer"
            style="@style/CrocodylWidgetCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
