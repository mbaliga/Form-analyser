<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for Active rig (sample values). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/CrocodylWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <TextView
        style="@style/CrocodylWidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_active_rig_name" />
    <TextView
        style="@style/CrocodylWidgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_rig_name" />
    <TextView
        style="@style/CrocodylWidgetCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_rig_meta" />
    <TextView
        style="@style/CrocodylWidgetBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_rig_detail" />
</LinearLayout>
