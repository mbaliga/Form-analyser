<?xml version="1.0" encoding="utf-8"?>
<!-- Every template below its small layout (a 1-row widget in landscape, or a font scale too large
     for the small layout): one tappable line, the value and a caption, no label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/CrocodylWidgetRootCompact"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/widget_value"
        style="@style/CrocodylWidgetValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/widget_caption"
        style="@style/CrocodylWidgetCaption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1" />
</LinearLayout>
