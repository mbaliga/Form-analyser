<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for This week (sample values). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/CrocodylWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <TextView
        style="@style/CrocodylWidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_this_week_name" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_value"
            style="@style/CrocodylWidgetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_week_total" />
        <TextView
            android:id="@+id/widget_unit"
            style="@style/CrocodylWidgetUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_week_unit" />
    </LinearLayout>
    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:indeterminate="false"
        android:max="1000"
        android:progress="713"
        android:progressDrawable="@drawable/widget_progress" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            style="@style/CrocodylWidgetCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_week_caption" />
        <TextView
            style="@style/CrocodylWidgetCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_week_sessions" />
    </LinearLayout>
</LinearLayout>
