<?xml version="1.0" encoding="utf-8"?>
<!-- pads template, large: the open scorecard line and six pads. The two rows share the height
     equally (nested weights; six pads in a widget are cheap to measure). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    style="@style/CrocodylWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp"
    android:orientation="vertical">
    <TextView
        android:id="@+id/widget_caption"
        style="@style/CrocodylWidgetCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        tools:ignore="NestedWeights">
        <LinearLayout
            android:id="@+id/widget_pad1"
            style="@style/CrocodylWidgetPad"
            tools:ignore="UseCompoundDrawables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_pad1_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_pad1_label"
                style="@style/CrocodylWidgetPadLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_pad2"
            style="@style/CrocodylWidgetPad"
            tools:ignore="UseCompoundDrawables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp">
            <ImageView
                android:id="@+id/widget_pad2_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_pad2_label"
                style="@style/CrocodylWidgetPadLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_pad3"
            style="@style/CrocodylWidgetPad"
            tools:ignore="UseCompoundDrawables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp">
            <ImageView
                android:id="@+id/widget_pad3_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_pad3_label"
                style="@style/CrocodylWidgetPadLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        tools:ignore="NestedWeights">
        <LinearLayout
            android:id="@+id/widget_pad4"
            style="@style/CrocodylWidgetPad"
            tools:ignore="UseCompoundDrawables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_pad4_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_pad4_label"
                style="@style/CrocodylWidgetPadLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_pad5"
            style="@style/CrocodylWidgetPad"
            tools:ignore="UseCompoundDrawables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp">
            <ImageView
                android:id="@+id/widget_pad5_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_pad5_label"
                style="@style/CrocodylWidgetPadLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_pad6"
            style="@style/CrocodylWidgetPad"
            tools:ignore="UseCompoundDrawables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp">
            <ImageView
                android:id="@+id/widget_pad6_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_pad6_label"
                style="@style/CrocodylWidgetPadLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
