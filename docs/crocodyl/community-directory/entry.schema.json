{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crocodyl.local/schemas/community-directory-entry.json",
  "title": "Crocodyl community directory entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "country", "region", "source", "sourceUrl", "lastVerifiedAt", "license"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "kind": { "enum": ["coach", "training_centre", "store"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "country": { "type": "string", "minLength": 2, "maxLength": 2 },
    "region": { "type": "string", "minLength": 1, "maxLength": 120 },
    "city": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "website": { "type": "string", "format": "uri" },
    "email": { "type": "string", "format": "email" },
    "phone": { "type": "string", "maxLength": 80 },
    "source": { "enum": ["curated", "community", "imported"] },
    "sourceUrl": { "type": "string", "format": "uri" },
    "lastVerifiedAt": { "type": "string", "format": "date" },
    "license": { "type": "string", "minLength": 1, "maxLength": 160 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 48 }, "maxItems": 32 }
  },
  "anyOf": [
    { "required": ["website"] },
    { "required": ["email"] },
    { "required": ["phone"] }
  ]
}
